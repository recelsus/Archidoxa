---
import type { PopupClientIndex } from '@/infrastructure/popup/popup_index_repository';

interface Props {
  popup_index: PopupClientIndex;
}

const { popup_index } = Astro.props;
---

<aside class="notes_region" aria-label="サイドノート">
  <div class="notes_toolbar">
    <button class="side_note_button" type="button" data_clear_notes aria-label="サイドノートをすべて削除">clear</button>
  </div>
  <div class="notes_placeholder" data_notes_placeholder>
    click an underlined annotation to pin it here
  </div>
  <div data_notes_container></div>
  <div class="notes_status" data_notes_status hidden aria-live="polite"></div>
</aside>
<script id="article_popup_index" type="application/json" set:html={JSON.stringify(popup_index)} />
<script src="../../scripts/reference_client.ts"></script>
