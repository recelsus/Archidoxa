---
import { get_header_navigation } from '@/application/content/content_pages';
import { site_config } from '@/config/site';
import { top_page_config } from '@/config/top_page';
import ConfigurablePage from '@/components/page/ConfigurablePage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const navigation_items = await get_header_navigation(null);
const [all_navigation_item, ...section_navigation_items] = navigation_items;
const top_heading = top_page_config.heading ?? site_config.title;
const top_description = top_page_config.description ?? site_config.description;
---

<BaseLayout title={site_config.title} description={site_config.description} show_article_tree={false}>
  <ConfigurablePage
    page_config={top_page_config}
    heading={top_heading}
    description={top_description}
    all_navigation_item={all_navigation_item}
    section_navigation_items={section_navigation_items}
  />
</BaseLayout>
