---
import { about_page_config } from '@/config/about_page';
import ConfigurablePage from '@/components/page/ConfigurablePage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const about_heading = about_page_config.heading ?? 'About';
const about_description = about_page_config.description ?? 'About this content site foundation.';
---

<BaseLayout title={about_heading} description={about_description} show_article_tree={false}>
  <ConfigurablePage page_config={about_page_config} heading={about_heading} description={about_description} />
</BaseLayout>
